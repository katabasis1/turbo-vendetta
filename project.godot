[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://localization/strings.ru.translation", "res://localization/strings.en.translation")

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="cars"
3d_physics/layer_3="triggers"
3d_physics/layer_4="fall"
3d_physics/layer_5="projectiles"

[physics]

common/max_physics_steps_per_frame=4
3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[shader_globals]

sun_dir={
"type": "vec3",
"value": Vector3(-0.35, 0.25, -0.9)
}
sun_color={
"type": "color",
"value": Color(1, 0.9451, 0.8392, 1)
}
shadow_tint={
"type": "color",
"value": Color(0.251, 0.1647, 0.4118, 1)
}
rim_color={
"type": "color",
"value": Color(0.9529, 0.6275, 0.6588, 1)
}
horizon_color={
"type": "color",
"value": Color(0.9647, 0.698, 0.4196, 1)
}
fog_color={
"type": "color",
"value": Color(0.9216, 0.4824, 0.5765, 1)
}
fog_start={
"type": "float",
"value": 60.0
}
fog_end={
"type": "float",
"value": 400.0
}
